# Copy this template to the gitignored deploy/compose.env and keep that copy
# private; optional authentication modes may add secrets to it.
NOISEDECK_HOST_PORT=18082
NOISEDECK_IMAGE_TAG=local

# Required by the checked-in Noisefloor production profile. It replaces the
# old host-local LAN overlay so the published address cannot drift outside
# review. Keep 127.0.0.1 when the reverse proxy runs on this Docker host.
NOISEDECK_PUBLISH_ADDRESS=127.0.0.1

# Numeric identity shared by the image, Compose process, named-volume seed,
# and tmpfs mounts. Set these to the owner of the host project and credential
# paths (often 1000:1000 on a single-user Linux host). The image default is
# 1026:100.
NOISEDECK_RUNTIME_UID=1026
NOISEDECK_RUNTIME_GID=100

# Production uses a dedicated disk-backed host directory for /tmp instead of
# charging provider builds and logs to RAM. Create this directory with the
# runtime UID/GID above and enforce the desired capacity on the host filesystem
# (32 GiB on the Noisefloor production host). Deck partitions and reclaims each
# generation's TMPDIR; the filesystem quota is burst capacity rather than a
# cleanup mechanism or a shared-UID security boundary.
NOISEDECK_TMP_HOST_PATH=/path/to/noisedeck-tmp

# Optional explicit production-host authority. Without it, the first boot
# creates a private receipt in the durable data volume and binds that volume
# to the mounted host identity. For production and migration, compute this
# privately on the one
# host authorized to run this deployment:
#   sha256sum /etc/machine-id | awk '{print $1}'
# Every app start compares this value with the host identity mounted read-only
# by Compose and refuses before provisioning or MCP startup on a mismatch.
# During a host cutover, transfer this authority to the target and remove the
# retired source's deploy environment before starting the target.
NOISEDECK_DEPLOYMENT_HOST_SHA256=

# Unconfined capacity-routing experiment switch. The generic Compose
# default is false; only the exact strings true and false pass the production
# verifier. Setting it to true activates the unconfined capacity-routing
# experiment and grants no added
# authentication, authority, Continuity, or confinement claim or boundary;
# the deployment remains ordinary unconfined. Changing the value takes
# effect through the ordinary redeploy commands, and
# rollback is restoring false plus
# the same ordinary redeploy.
NOISEDECK_EXPERIMENTS_UNCONFINED_CAPACITY_ROUTING=false

# The public origin the browser uses to reach Deck through the reverse
# proxy. The zero-config default is http://127.0.0.1:${NOISEDECK_HOST_PORT}.
# A production override becomes the only trusted WebSocket origin
# and, in OIDC mode, the base of the exact Google callback. No trailing slash
# — the config loader rejects one.
NOISEDECK_PUBLIC_ORIGIN=https://deck.example.com

# Session-cookie security is derived from this origin: HTTPS selects the
# Secure attribute and __Host- prefix; plain HTTP is accepted only for the
# declared-loopback development path.

# Host directory bound as /workspace in the container — the projects root
# (projects live directly under the workspace mount). Everything
# beneath it is visible to provider CLIs, including files and dot-directories
# the folder picker hides, so point this at the workspace you intend to share.
NOISEDECK_PROJECTS_HOST_PATH=/workspace

# Optional: required only when compose.mempalace.yaml is included. This
# existing durable store is then mounted directly so its state remains
# authoritative across deployments.
NOISEDECK_MEMPALACE_HOST_PATH=/path/to/existing/mempalace

# Password is the secure generic-profile default. The Noisefloor production
# command requires Google OIDC: uncomment every line below, generate a
# dedicated session secret, and register the exact callback
# ${NOISEDECK_PUBLIC_ORIGIN}/auth/callback. Do not reuse another service's
# callback or session secret.
# Existing installations upgrading from a release without auth-mode.json must
# stop the app and adopt the intended mode once before starting the new image:
#   docker compose run --rm --no-deps app \
#     /usr/local/bin/noise deck auth-mode adopt --mode oidc
# Every later mode change uses the offline `auth-mode transition` command.
# NOISEDECK_AUTH_MODE=oidc
# NOISEDECK_AUTH_SESSION_SECRET=replace-with-an-independent-random-session-secret
# GOOGLE_OIDC_CLIENT_ID=example-client-id.apps.googleusercontent.com
# GOOGLE_OIDC_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_OIDC_ALLOWED_EMAIL=you@example.com

# The host's gh CLI config (hosts.yml with the GitHub token), shared into the
# container so sessions inherit your GitHub auth. Default
# is ~/.config/gh. The mount is read-write: token refreshes and gh auth login
# inside a session persist back to this directory.
# To authenticate, prefer running gh auth login on the host: the config lands
# here and the container sees it on the next command, no restart needed. To
# authenticate inside a session instead, run gh auth login and pick "Login
# with a web browser" — the image has no browser, so gh prints the one-time
# code and device URL (github.com/login/device) for you to open on your own
# machine; it does not try to launch one. The token flow
# (gh auth login --with-token) also works and never touches a browser.
NOISEDECK_GH_CONFIG_HOST_PATH=~/.config/gh

# Provider CLIs (codex, kimi), Command Code, Cline, Cursor Agent, Grok Build, Kilo,
# MiMo Code, Qoder, Qwen Code, and the Pi harness you invoke yourself ship in the image.
# Their auth lives in the deck-home volume (~/.codex, ~/.kimi-code,
# ~/.commandcode, ~/.cline, ~/.config/kilo, ~/.config/mimocode,
# ~/.local/share/mimocode, ~/.cursor, ~/.grok, ~/.qoder, ~/.qwen,
# ~/.pi/agent): authenticate once
# inside any session and it persists across redeploys. Command Code is
# version-pinned in the image; Deck launches it with its documented
# auto-update suppression flag.
# For Pi, run it interactively, use /login, and select ZAI Coding Plan (Global);
# Pi stores the key in ~/.pi/agent/auth.json with mode 0600.
# Do not put the key in this Compose environment or pass it with --api-key;
# either form exposes it beyond Pi's private credential store.
# The SessionStart hook registration and codex's hook trust are seeded by the
# image bootstrap on first boot — do not bind a host provider home over them
# unless it already carries the documented hook entries (the launch gate's
# error names what is missing).

# Devin is selectable in the session picker. The image bootstrap creates or
# updates ~/.config/devin/config.json with `"attribution": false`,
# `"auto_update": false`, and Deck's documented SessionStart hook. Run
# `devin auth login` from a terminal before the first Deck launch; the existing
# deck-home volume preserves its private ~/.local/share/devin/credentials.toml.

# Swap is independent of encrypted workspace storage. Personal permits ordinary
# swap; paranoid requires a verified active dm-crypt swap device.
# The native gateway overrides this from
# its pinned native.SwapPolicy when it launches the encrypted workload.
NOISEDECK_SEALED_SWAP_POLICY=personal

# GitHub organization for the Tasks, SDLC and Visual Diff sources (forks and mirrors only).
# NOISEDECK_SOURCE_ORG=noisefloor-oss
