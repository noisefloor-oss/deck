diff --git a/mempalace/minilm_onnx.py b/mempalace/minilm_onnx.py
new file mode 100644
index 0000000..e5ffd6f
--- /dev/null
+++ b/mempalace/minilm_onnx.py
@@ -0,0 +1,174 @@
+"""Local all-MiniLM-L6-v2 inference without a vector-database dependency."""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import os
+import tarfile
+import tempfile
+import threading
+import urllib.request
+from functools import cached_property
+from pathlib import Path
+
+import numpy as np
+
+
+class MiniLMONNX:
+    MODEL_URL = "https://chroma-onnx-models.s3.amazonaws.com/all-MiniLM-L6-v2/onnx.tar.gz"
+    MODEL_SHA256 = "913d7300ceae3b2dbc2c50d1de4baacab4be7b9380491c27fab7418616a16ec3"
+    FILES = (
+        "config.json",
+        "model.onnx",
+        "special_tokens_map.json",
+        "tokenizer_config.json",
+        "tokenizer.json",
+        "vocab.txt",
+    )
+
+    def __init__(self, preferred_providers=None, intra_op_num_threads=0):
+        import onnxruntime as ort
+        from tokenizers import Tokenizer
+
+        self.ort = ort
+        self.Tokenizer = Tokenizer
+        self._preferred_providers = list(preferred_providers or [])
+        self._intra_op_num_threads = intra_op_num_threads
+        self._run_lock = threading.Lock()
+        self._load_lock = threading.Lock()
+        self._verified = False
+        self.root = Path.home() / ".cache" / "chroma" / "onnx_models" / "all-MiniLM-L6-v2"
+        self.model_dir = self.root / "onnx"
+
+    @staticmethod
+    def name():
+        return "default"
+
+    @staticmethod
+    def max_tokens():
+        return 256
+
+    def default_space(self):
+        return "cosine"
+
+    def supported_spaces(self):
+        return ["cosine", "l2", "ip"]
+
+    def _download(self):
+        self.model_dir.mkdir(parents=True, exist_ok=True)
+        archive = self.root / "onnx.tar.gz"
+        if not archive.exists() or self._sha256(archive) != self.MODEL_SHA256:
+            with urllib.request.urlopen(self.MODEL_URL, timeout=120) as response:
+                fd, temporary = tempfile.mkstemp(prefix=".onnx-", dir=self.root)
+                try:
+                    with os.fdopen(fd, "wb") as output:
+                        while chunk := response.read(1024 * 1024):
+                            output.write(chunk)
+                    if self._sha256(Path(temporary)) != self.MODEL_SHA256:
+                        raise RuntimeError("the MiniLM model archive failed its SHA-256 check")
+                    os.replace(temporary, archive)
+                finally:
+                    if os.path.exists(temporary):
+                        os.unlink(temporary)
+        with tarfile.open(archive, mode="r:gz") as bundle:
+            for name in self.FILES:
+                destination = self.model_dir / name
+                member = bundle.getmember(f"onnx/{name}")
+                if not member.isfile():
+                    raise RuntimeError(f"the MiniLM archive has an invalid {name} entry")
+                source = bundle.extractfile(member)
+                if source is None:
+                    raise RuntimeError(f"the MiniLM archive has no readable {name} entry")
+                with source:
+                    if destination.exists():
+                        digest = hashlib.sha256()
+                        while chunk := source.read(1024 * 1024):
+                            digest.update(chunk)
+                        if self._sha256(destination) == digest.hexdigest():
+                            continue
+                        source.seek(0)
+                    fd, temporary = tempfile.mkstemp(prefix=f".{name}.", dir=self.model_dir)
+                    try:
+                        with os.fdopen(fd, "wb") as output:
+                            while chunk := source.read(1024 * 1024):
+                                output.write(chunk)
+                        os.replace(temporary, destination)
+                    finally:
+                        if os.path.exists(temporary):
+                            os.unlink(temporary)
+
+    @staticmethod
+    def _sha256(path):
+        digest = hashlib.sha256()
+        with path.open("rb") as source:
+            while chunk := source.read(1024 * 1024):
+                digest.update(chunk)
+        return digest.hexdigest()
+
+    def _ensure_model(self):
+        if self._verified:
+            return
+        with self._load_lock:
+            if not self._verified:
+                self._download()
+                self._verified = True
+
+    @cached_property
+    def tokenizer(self):
+        tokenizer = self.Tokenizer.from_file(str(self.model_dir / "tokenizer.json"))
+        tokenizer.enable_truncation(max_length=self.max_tokens())
+        tokenizer.enable_padding(pad_id=0, pad_token="[PAD]", length=self.max_tokens())
+        return tokenizer
+
+    @cached_property
+    def model(self):
+        providers = self._preferred_providers or self.ort.get_available_providers()
+        providers = [name for name in providers if name != "CoreMLExecutionProvider"]
+        if not set(providers).issubset(self.ort.get_available_providers()):
+            raise ValueError("a requested ONNX Runtime provider is unavailable")
+        options = self.ort.SessionOptions()
+        options.log_severity_level = 3
+        options.graph_optimization_level = self.ort.GraphOptimizationLevel.ORT_ENABLE_ALL
+        if self._intra_op_num_threads > 0:
+            options.intra_op_num_threads = self._intra_op_num_threads
+        return self.ort.InferenceSession(
+            str(self.model_dir / "model.onnx"), sess_options=options, providers=providers
+        )
+
+    def _forward(self, documents, batch_size=32):
+        outputs = []
+        for start in range(0, len(documents), batch_size):
+            encoded = [self.tokenizer.encode(text) for text in documents[start : start + batch_size]]
+            if any(len(item.ids) > self.max_tokens() for item in encoded):
+                raise ValueError(f"MiniLM input exceeds {self.max_tokens()} tokens")
+            input_ids = np.asarray([item.ids for item in encoded], dtype=np.int64)
+            attention_mask = np.asarray([item.attention_mask for item in encoded], dtype=np.int64)
+            token_type_ids = np.zeros_like(input_ids)
+            serial = self._run_lock if "DmlExecutionProvider" in self._preferred_providers else contextlib.nullcontext()
+            with serial:
+                hidden = self.model.run(
+                    None,
+                    {
+                        "input_ids": input_ids,
+                        "attention_mask": attention_mask,
+                        "token_type_ids": token_type_ids,
+                    },
+                )[0]
+            mask = np.broadcast_to(attention_mask[..., None], hidden.shape)
+            pooled = np.sum(hidden * mask, axis=1) / np.clip(mask.sum(axis=1), 1e-9, None)
+            norms = np.linalg.norm(pooled, axis=1)
+            norms[norms == 0] = 1e-12
+            outputs.append((pooled / norms[:, None]).astype(np.float32))
+        return np.concatenate(outputs) if outputs else np.empty((0, 384), dtype=np.float32)
+
+    def __call__(self, input):
+        if isinstance(input, str) or not isinstance(input, (list, tuple)):
+            raise TypeError("MiniLM input must be a list of documents")
+        if not all(isinstance(text, str) for text in input):
+            raise TypeError("MiniLM documents must be text")
+        self._ensure_model()
+        return list(self._forward(list(input)))
+
+    def embed_query(self, input):
+        return self(input)
